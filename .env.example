# Server Configuration
PORT=3003

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/jolofi_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Twilio Configuration for SMS/Email Verification
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SID=your_twilio_verify_service_sid

# SUI Blockchain Configuration (if needed)
SUI_API_ENDPOINT=https://fullnode.devnet.sui.io